{
  "name": "WF-05_payment_evidence",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payment-proof",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "00000001-0000-4000-8000-000000000000",
      "name": "Evento payment.proof_received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_WEBHOOK_SECRET",
          "name": "Secreto compartido del despachador"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event_type }}",
              "rightValue": "payment.proof_received",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "00000002-0000-4000-8000-000000000000",
      "name": "Filtrar tipo de evento",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_BASE_URL }}/internal/conversations/{{ $('Evento payment.proof_received').item.json.body.customer_id }}/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "retry": {
            "maxTries": 3,
            "waitBetween": 2000
          }
        }
      },
      "id": "00000003-0000-4000-8000-000000000000",
      "name": "Obtener contexto del cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_INTERNAL_API",
          "name": "API interna RETEQUE (x-internal-secret)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/internal/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "retry": {
            "maxTries": 3,
            "waitBetween": 2000
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.customer.wa_id, text: 'Recibimos tu comprobante del pedido ' + $('Evento payment.proof_received').item.json.body.order_code + '. Estamos verificando el pago; te confirmaremos cuando finalice la revisión.', idempotency_key: 'proof-' + $('Evento payment.proof_received').item.json.body.event_id }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'proof-' + $('Evento payment.proof_received').item.json.body.event_id }}"
            }
          ]
        }
      },
      "id": "00000004-0000-4000-8000-000000000000",
      "name": "Acuse al cliente (nunca 'pagado')",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_INTERNAL_API",
          "name": "API interna RETEQUE (x-internal-secret)"
        }
      }
    },
    {
      "parameters": {},
      "id": "00000005-0000-4000-8000-000000000000",
      "name": "Ignorar otros eventos",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        520,
        120
      ]
    }
  ],
  "connections": {
    "Evento payment.proof_received": {
      "main": [
        [
          {
            "node": "Filtrar tipo de evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar tipo de evento": {
      "main": [
        [
          {
            "node": "Obtener contexto del cliente",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ignorar otros eventos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener contexto del cliente": {
      "main": [
        [
          {
            "node": "Acuse al cliente (nunca 'pagado')",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "errorWorkflow": "WF-08_errors_and_retries"
  },
